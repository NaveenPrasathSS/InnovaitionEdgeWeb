# Only variables prefixed with PUBLIC_ are exposed to the browser at build time.

# Power Automate HTTP trigger URL for the /contact form.
# Fill in with the "When an HTTP request is received" URL from your flow.
PUBLIC_CONTACT_FLOW_URL=https://your-power-automate-http-trigger-url

# Microsoft Clarity project id (leave empty to disable the tag).
# Find it at clarity.microsoft.com → your project → Settings → Setup.
PUBLIC_CLARITY_ID=

# Plausible analytics domain (leave empty to disable the tag).
# Example: innovaitionedge.com
PUBLIC_PLAUSIBLE_DOMAIN=

# Optional — override Plausible script URL for self-hosted / proxy setups.
# Default: https://plausible.io/js/script.js
PUBLIC_PLAUSIBLE_SRC=
