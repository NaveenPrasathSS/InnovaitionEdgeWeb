---
import '../styles/globals.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'InnovAItion Edge — Microsoft 365 modernization with AI agents, custom Teams and SharePoint apps, and Power Platform automation.',
  canonical,
  ogImage = '/logo.png',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(canonical ?? Astro.url.pathname, Astro.site).toString();
const ogImageURL = new URL(ogImage, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f48027" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="author" content="InnovAItion Edge" />
    <meta name="publisher" content="InnovAItion Edge" />
    <meta name="generator" content="Astro" />

    <!-- Geo — registered address for local-SEO signals -->
    <meta name="geo.region" content="IN-TN" />
    <meta name="geo.placename" content="Karur, Tamil Nadu, India" />
    <meta name="geo.position" content="10.9601;78.0766" />
    <meta name="ICBM" content="10.9601, 78.0766" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon-large.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />

    <Analytics />
  </head>
  <body>
    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Scroll-reveal: watches [data-reveal] elements and adds .is-visible
      // when they enter the viewport. One-shot per element, respects
      // prefers-reduced-motion, gracefully falls back to visible without JS.
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const targets = document.querySelectorAll('[data-reveal]');

      if (prefersReduced || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        // Small deferral so above-the-fold elements animate in after paint
        // (otherwise they're already intersecting before the transition kicks
        // in and the effect is invisible).
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: '0px 0px -80px 0px' },
        );
        requestAnimationFrame(() => {
          setTimeout(() => targets.forEach((el) => io.observe(el)), 120);
        });
      }
    </script>
  </body>
</html>
