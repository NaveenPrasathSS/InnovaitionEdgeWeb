---
import Button from './Button.astro';

interface Props {
  heading?: string;
  subheading?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  heading = 'Ready to modernize your Microsoft 365 workplace?',
  subheading = 'Book a 30-minute discovery call — we\'ll map the highest-leverage opportunities across your SharePoint, Teams, and Power Platform footprint.',
  ctaHref = '/contact',
  ctaLabel = 'Book a discovery call',
} = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{subheading}</p>
    </div>
    <div class="cta-actions">
      <Button href={ctaHref} variant="primary" size="lg">{ctaLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background:
      radial-gradient(ellipse at top right, rgba(244, 128, 39, 0.10), transparent 60%),
      linear-gradient(180deg, var(--color-ink-900), #05070d);
    color: #ffffff;
    padding: var(--space-16) 0;
    margin-top: var(--space-24);
    position: relative;
    overflow: hidden;
  }

  .cta-banner::after {
    content: '';
    position: absolute;
    inset: auto -20% -60% auto;
    width: 60%;
    height: 200%;
    background: radial-gradient(ellipse, rgba(244, 128, 39, 0.14), transparent 60%);
    pointer-events: none;
  }

  .cta-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-10);
    position: relative;
    z-index: 1;
  }

  .cta-banner h2 {
    color: #ffffff;
    max-width: 22ch;
    margin: 0 0 var(--space-4);
  }

  .cta-banner p {
    color: rgba(255, 255, 255, 0.75);
    max-width: 56ch;
    font-size: var(--fs-md);
    margin: 0;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
  }

  @media (max-width: 780px) {
    .cta-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
