---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CTABanner from '../components/CTABanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema } from '../lib/schema';

const services = [
  {
    href: '/services/sharepoint',
    eyebrow: 'SharePoint',
    title: 'Modern SharePoint intranets',
    body: 'Rebuild dated SharePoint estates into performant hubs — SPFx components, custom search, and content architectures your teams actually use.',
  },
  {
    href: '/services/teams',
    eyebrow: 'Teams',
    title: 'Teams apps that fit the way you work',
    body: 'Line-of-business Teams apps with adaptive cards, message extensions, and bot integrations — shipped as native experiences, not iframed refugees.',
  },
  {
    href: '/services/power-platform',
    eyebrow: 'Power Platform',
    title: 'Automation that removes real friction',
    body: 'Power Apps + Power Automate flows that replace the spreadsheet-and-email operational drag most enterprises are still living with.',
  },
  {
    href: '/services/azure-ai',
    eyebrow: 'Azure AI',
    title: 'AI agents grounded in your M365 tenant',
    body: 'Copilot Studio and Azure AI Foundry solutions grounded in your Graph data — assistants that actually know your business, not generic chatbots.',
  },
];

const solutions = [
  {
    icon: 'M4 4h16v12H4z M2 20h20',
    title: 'Modern Workplace',
    body: 'Microsoft 365, Teams and SharePoint configured for the way your business actually works — secure collaboration, real search, and content architecture your people trust.',
    tags: ['SharePoint', 'Teams', 'OneDrive'],
  },
  {
    icon: 'M13 2L3 14h9l-1 8l10-12h-9z',
    title: 'Low-Code Automation',
    body: 'Power Apps and Power Automate flows that retire the spreadsheet-and-email drag — approvals, requests, and case management built on Dataverse.',
    tags: ['Power Apps', 'Automate', 'Dataverse'],
  },
  {
    icon: 'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10s10-4.5 10-10S17.5 2 12 2z M12 6v6l4 2',
    title: 'AI Knowledge Assistants',
    body: 'Copilot Studio and Azure AI Foundry agents grounded in your Graph — assistants that answer from your SharePoint, Teams, and OneDrive with proper permission trimming.',
    tags: ['Copilot Studio', 'Azure OpenAI', 'RAG'],
  },
  {
    icon: 'M3 3h18v18H3z M3 9h18 M9 21V9',
    title: 'Custom Teams Apps',
    body: 'Line-of-business Teams apps built as first-class experiences — Adaptive Cards, message extensions, meeting apps, Bot Framework integrations, and SSO.',
    tags: ['Teams Toolkit', 'Adaptive Cards', 'Bot Framework'],
  },
  {
    icon: 'M12 2v20 M2 12h20',
    title: 'SharePoint Modernization',
    body: 'End-to-end classic-to-modern migrations with SPFx web parts, hub site architecture, search reindexing, and governance your records team signs off on.',
    tags: ['SPFx', 'Hub sites', 'SharePoint Search'],
  },
  {
    icon: 'M3 12l3-3l3 3l3-3l3 3l3-3l3 3v9H3z',
    title: 'BI & Reporting',
    body: 'Power BI dashboards on top of a proper semantic model — connected to Dataverse, Graph, and your line-of-business SQL, distributed via SharePoint or Teams.',
    tags: ['Power BI', 'Semantic model', 'Dataverse'],
  },
];

const values = [
  {
    heading: 'We dogfood the pitch',
    body: 'Our own operations run on Power Automate flows, SharePoint pages, and Teams apps. Everything we sell, we use daily.',
  },
  {
    heading: 'Direct access to builders',
    body: 'You work with the engineers building your solution. No account layer, no handoff friction. Ideas to shipped in weeks, not quarters.',
  },
  {
    heading: 'M365 depth over breadth',
    body: 'We do not chase every SaaS trend. All four practice areas share the same M365 substrate — decisions compound instead of fragmenting.',
  },
];
---

<Layout
  title="InnovAItion Edge — Microsoft 365 Solutions Company | Innovation Edge"
  description="InnovAItion Edge (Innovation Edge) is a Microsoft 365 solutions and IT services company. We build SharePoint, Teams, Power Platform and Azure AI solutions for enterprise clients across the United States, United Kingdom, Israel, Europe and India."
>
  <Fragment slot="head">
    <JsonLd schema={organizationSchema} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Microsoft 365 Solutions Provider · Global</p>
        <h1>
          Turn Microsoft&nbsp;365 into an
          <span class="hero-accent">operational advantage</span>.
        </h1>
        <p class="lede">
          We modernize the enterprise workplace with AI agents, custom Teams &amp;
          SharePoint apps, and Power Platform automation — built on the M365
          substrate you already own, delivered in weeks, not quarters.
        </p>
        <div class="hero-actions">
          <Button href="/contact" variant="primary" size="lg">Book a discovery call</Button>
          <Button href="/services" variant="secondary" size="lg">Explore services</Button>
        </div>
        <p class="hero-note">
          <span aria-hidden="true">↳</span>
          Typical engagements ship in 4–8 weeks on the M365 stack you already own.
        </p>
      </div>

      <!-- Interactive M365 pillar grid — hover any tile to see how the
           surrounding pillars connect through the same Microsoft substrate. -->
      <div class="hero-visual" data-hero-stack aria-label="Microsoft 365 stack — hover a pillar to see related surfaces">
        <div class="pillar-badge" data-tech="sharepoint"      data-related="teams,graph,copilot-studio">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#038387,#03838799);">SP</span>
          <span>SharePoint</span>
        </div>
        <div class="pillar-badge" data-tech="azure-ai"        data-related="copilot-studio,graph">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#0078d4,#0078d499);">AI</span>
          <span>Azure AI</span>
        </div>
        <div class="pillar-badge" data-tech="teams"           data-related="sharepoint,copilot-studio,power-platform">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#4b53bc,#4b53bc99);">T</span>
          <span>Teams</span>
        </div>
        <div class="pillar-badge" data-tech="copilot-studio"  data-related="azure-ai,teams,graph,sharepoint">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#0d47a1,#0d47a199);">CS</span>
          <span>Copilot Studio</span>
        </div>
        <div class="pillar-badge" data-tech="power-platform"  data-related="teams,graph,copilot-studio">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#742774,#74277499);">P</span>
          <span>Power Platform</span>
        </div>
        <div class="pillar-badge" data-tech="graph"           data-related="sharepoint,azure-ai,copilot-studio,power-platform,teams">
          <span class="pillar-mark" style="background: linear-gradient(135deg,#7fba00,#7fba0099);">MG</span>
          <span>Graph</span>
        </div>
        <p class="hero-visual-hint" aria-hidden="true">
          <span>↳</span> Hover any pillar to see related surfaces
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions we deliver -->
  <section class="section solutions" aria-labelledby="solutions-h">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-eyebrow">Key solutions</p>
        <h2 id="solutions-h">Six kinds of outcomes we ship on the Microsoft&nbsp;365 stack</h2>
        <p class="section-sub">
          Every engagement lands one of these — sometimes bundled, sometimes
          standalone. Each is grounded in the platforms your enterprise
          already owns.
        </p>
      </header>

      <div class="solutions-grid">
        {solutions.map((sol, i) => (
          <article class="solution-card" data-reveal data-reveal-delay={String((i % 3) + 1)}>
            <span class="solution-icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d={sol.icon} />
              </svg>
            </span>
            <h3>{sol.title}</h3>
            <p>{sol.body}</p>
            <ul class="solution-tags" aria-label="Technology tags">
              {sol.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities (practice areas) -->
  <section class="section capabilities" aria-labelledby="capabilities-h">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-eyebrow">Practice areas</p>
        <h2 id="capabilities-h">Four practice areas, one Microsoft&nbsp;365 substrate</h2>
        <p class="section-sub">
          We build across the M365 stack — but always with the same underlying
          bet: that Microsoft's platform depth, applied deliberately, beats a
          zoo of third-party SaaS.
        </p>
      </header>

      <div class="capability-grid">
        {services.map((s, i) => (
          <div data-reveal data-reveal-delay={String((i % 2) + 1)}>
            <Card href={s.href} eyebrow={s.eyebrow} title={s.title}>
              <p>{s.body}</p>
            </Card>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Value / why-us -->
  <section class="section values" aria-labelledby="values-h">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="section-eyebrow">Why us</p>
        <h2 id="values-h">Three reasons enterprise IT teams pick us</h2>
      </header>

      <div class="value-grid">
        {values.map((v, i) => (
          <div class="value" data-reveal data-reveal-delay={String(i + 1)}>
            <h3>{v.heading}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<script>
  // Interactive M365 stack — hovering a pillar dims non-related pillars
  // and highlights related ones. Data attributes define the graph.
  const stack = document.querySelector('[data-hero-stack]') as HTMLElement | null;
  if (stack) {
    const badges = Array.from(stack.querySelectorAll<HTMLElement>('.pillar-badge'));

    const focus = (pillar: HTMLElement) => {
      const related = new Set((pillar.dataset.related || '').split(',').filter(Boolean));
      stack.classList.add('is-focused');
      badges.forEach((b) => {
        b.classList.toggle('is-focus', b === pillar);
        b.classList.toggle('is-related', b !== pillar && related.has(b.dataset.tech || ''));
      });
    };

    const clearFocus = () => {
      stack.classList.remove('is-focused');
      badges.forEach((b) => b.classList.remove('is-focus', 'is-related'));
    };

    badges.forEach((badge) => {
      badge.addEventListener('mouseenter', () => focus(badge));
      badge.addEventListener('focus', () => focus(badge));
    });
    stack.addEventListener('mouseleave', clearFocus);
    stack.addEventListener('focusout', (event) => {
      if (!stack.contains((event as FocusEvent).relatedTarget as Node)) clearFocus();
    });
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .hero {
    position: relative;
    padding: var(--space-24) 0 var(--space-16);
    background:
      radial-gradient(ellipse at 10% -10%, rgba(244, 128, 39, 0.12), transparent 55%),
      radial-gradient(ellipse at 95% 20%, rgba(75, 83, 188, 0.08), transparent 55%),
      linear-gradient(180deg, #fff, var(--color-surface-alt));
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: auto -10% -30% -10%;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--color-surface));
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-12);
    align-items: center;
    position: relative;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-5);
  }
  .hero h1 {
    max-width: 20ch;
  }
  .hero-accent {
    background: linear-gradient(120deg, var(--color-primary), var(--color-primary-cta));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .lede {
    font-size: var(--fs-lg);
    color: var(--color-ink-500);
    max-width: 58ch;
    margin: var(--space-6) 0 var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .hero-note {
    color: var(--color-ink-400);
    font-size: var(--fs-sm);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Hero visual — decorative pillar grid */
  .hero-visual {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    align-content: center;
  }
  .pillar-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-1);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--color-ink-900);
    cursor: default;
    transition: transform var(--dur-med) var(--ease-out),
                box-shadow var(--dur-med) var(--ease-out),
                border-color var(--dur-med) var(--ease-out),
                opacity var(--dur-med) var(--ease-out);
  }
  .pillar-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }
  /* Interactive stack — when a pillar is hovered inside the grid,
     dim the non-related pillars and lift both the hovered and related ones. */
  .hero-visual.is-focused .pillar-badge {
    opacity: 0.4;
    transform: none;
  }
  .hero-visual.is-focused .pillar-badge.is-related {
    opacity: 1;
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }
  .hero-visual.is-focused .pillar-badge.is-focus {
    opacity: 1;
    border-color: var(--color-primary-cta);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(244, 128, 39, 0.24);
  }
  .hero-visual-hint {
    grid-column: 1 / -1;
    color: var(--color-ink-400);
    font-size: var(--fs-xs);
    margin: var(--space-3) 0 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    opacity: 0;
    transition: opacity var(--dur-med) var(--ease-out);
  }
  .hero-visual:hover .hero-visual-hint,
  .hero-visual:focus-within .hero-visual-hint {
    opacity: 1;
  }
  .pillar-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 var(--space-2);
    border-radius: 8px;
    color: #ffffff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.75rem;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.14);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      grid-template-columns: repeat(3, 1fr);
      max-width: 480px;
    }
  }

  /* ── Section shared ──────────────────────────────────── */
  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .section-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-3);
  }
  .section-sub {
    font-size: var(--fs-md);
    color: var(--color-ink-500);
    margin: var(--space-4) 0 0;
    line-height: 1.6;
    max-width: 62ch;
  }

  /* ── Solutions ─────────────────────────────────────── */
  .solutions {
    background:
      radial-gradient(ellipse at 85% 20%, rgba(244, 128, 39, 0.05), transparent 60%),
      var(--color-surface);
  }
  .solutions-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .solution-card {
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    transition: transform var(--dur-med) var(--ease-out),
                border-color var(--dur-med) var(--ease-out),
                box-shadow var(--dur-med) var(--ease-out);
  }
  .solution-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary);
    box-shadow: var(--shadow-2);
  }
  .solution-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--color-primary-050), rgba(244, 128, 39, 0.18));
    color: var(--color-primary-cta);
    margin-bottom: var(--space-5);
  }
  .solution-card h3 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-3);
  }
  .solution-card p {
    color: var(--color-ink-500);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0 0 var(--space-5);
  }
  .solution-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .solution-tags li {
    font-size: var(--fs-xs);
    color: var(--color-ink-500);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .solutions-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .solutions-grid { grid-template-columns: 1fr; }
  }

  /* ── Capabilities ────────────────────────────────────── */
  .capabilities {
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 780px) {
    .capability-grid { grid-template-columns: 1fr; }
  }

  /* ── Values ──────────────────────────────────────────── */
  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  .value h3 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-3);
  }
  .value p {
    color: var(--color-ink-500);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 780px) {
    .value-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
