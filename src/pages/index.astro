---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import CTABanner from '../components/CTABanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { organizationSchema } from '../lib/schema';

const services = [
  {
    href: '/services/sharepoint',
    eyebrow: 'SharePoint',
    title: 'Modern SharePoint intranets',
    body: 'Rebuild dated SharePoint estates into performant hubs — SPFx components, custom search, and content architectures your teams actually use.',
  },
  {
    href: '/services/teams',
    eyebrow: 'Teams',
    title: 'Teams apps that fit the way you work',
    body: 'Line-of-business Teams apps with adaptive cards, message extensions, and bot integrations — shipped as native experiences, not iframed refugees.',
  },
  {
    href: '/services/power-platform',
    eyebrow: 'Power Platform',
    title: 'Automation that removes real friction',
    body: 'Power Apps + Power Automate flows that replace the spreadsheet-and-email operational drag most enterprises are still living with.',
  },
  {
    href: '/services/azure-ai',
    eyebrow: 'Azure AI',
    title: 'AI agents grounded in your M365 tenant',
    body: 'Copilot Studio and Azure AI Foundry solutions grounded in your Graph data — assistants that actually know your business, not generic chatbots.',
  },
];

const values = [
  {
    heading: 'We dogfood the pitch',
    body: 'Our own operations run on Power Automate flows, SharePoint pages, and Teams apps. Everything we sell, we use daily.',
  },
  {
    heading: 'Direct access to builders',
    body: 'You work with the engineers building your solution. No account layer, no handoff friction. Ideas to shipped in weeks, not quarters.',
  },
  {
    heading: 'M365 depth over breadth',
    body: 'We do not chase every SaaS trend. All four practice areas share the same M365 substrate — decisions compound instead of fragmenting.',
  },
];
---

<Layout
  title="InnovAItion Edge — Microsoft 365 modernization partner"
  description="A Microsoft 365 solutions provider modernizing the enterprise workplace with AI agents, custom Teams and SharePoint apps, and Power Platform automation."
>
  <Fragment slot="head">
    <JsonLd schema={organizationSchema} />
  </Fragment>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Microsoft 365 Solutions Provider · Coimbatore</p>
      <h1>
        We modernize the Microsoft&nbsp;365 workplace with
        <span class="hero-accent">AI agents</span>, custom Teams &amp; SharePoint apps,
        and Power Platform automation.
      </h1>
      <p class="lede">
        Enterprise IT leaders bring us in when their M365 estate needs to stop
        being a bundle of licenses and start being an operational advantage.
      </p>
      <div class="hero-actions">
        <Button href="/contact" variant="primary" size="lg">Book a discovery call</Button>
        <Button href="/services" variant="secondary" size="lg">See what we do</Button>
      </div>
      <p class="hero-note">
        <span aria-hidden="true">↳</span>
        Typical engagements ship in 4–8 weeks, on the Microsoft 365 substrate you already own.
      </p>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section capabilities" aria-labelledby="capabilities-h">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">What we do</p>
        <h2 id="capabilities-h">Four practice areas, one Microsoft 365 substrate</h2>
        <p class="section-sub">
          We build across the M365 stack — but always with the same underlying
          bet: that Microsoft's platform depth, applied deliberately, beats a
          zoo of third-party SaaS.
        </p>
      </header>

      <div class="capability-grid">
        {services.map((s) => (
          <Card href={s.href} eyebrow={s.eyebrow} title={s.title}>
            <p>{s.body}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <!-- Value / why-us -->
  <section class="section values" aria-labelledby="values-h">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">Why us</p>
        <h2 id="values-h">Three reasons enterprise IT teams pick us</h2>
      </header>

      <div class="value-grid">
        {values.map((v) => (
          <div class="value">
            <h3>{v.heading}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: var(--space-24) 0 var(--space-16);
    background:
      radial-gradient(ellipse at 20% -10%, rgba(244, 128, 39, 0.10), transparent 55%),
      linear-gradient(180deg, #fff, var(--color-surface-alt));
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: auto -10% -30% -10%;
    height: 40%;
    background: linear-gradient(180deg, transparent, var(--color-surface));
    pointer-events: none;
  }
  .hero-inner {
    max-width: 940px;
    position: relative;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-5);
  }
  .hero h1 {
    max-width: 22ch;
  }
  .hero-accent {
    color: var(--color-primary-700);
  }
  .lede {
    font-size: var(--fs-lg);
    color: var(--color-ink-500);
    max-width: 60ch;
    margin: var(--space-6) 0 var(--space-8);
  }
  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  .hero-note {
    color: var(--color-ink-400);
    font-size: var(--fs-sm);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Section shared */
  .section-head {
    max-width: 720px;
    margin-bottom: var(--space-12);
  }
  .section-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-3);
  }
  .section-sub {
    font-size: var(--fs-md);
    color: var(--color-ink-500);
    margin: var(--space-4) 0 0;
    line-height: 1.6;
  }

  /* Capabilities */
  .capability-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
  }
  @media (max-width: 780px) {
    .capability-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Values */
  .values {
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }
  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  .value h3 {
    font-size: var(--fs-xl);
    margin-bottom: var(--space-3);
  }
  .value p {
    color: var(--color-ink-500);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 780px) {
    .value-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
