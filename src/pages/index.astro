---
import Layout from '../layouts/Layout.astro';
---

<Layout title="InnovAItion Edge — Microsoft 365 modernization partner">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Microsoft 365 Solutions Provider</p>
      <h1>
        We modernize the Microsoft 365 workplace with
        <span class="hero-accent">AI agents</span>, custom Teams / SharePoint apps,
        and Power Platform automation.
      </h1>
      <p class="lede">
        Enterprise IT leaders trust us to translate Microsoft's platform depth
        (SharePoint, Teams, Power Platform, Azure AI) into shipped, measurable
        workplace outcomes.
      </p>
      <a class="btn btn-primary" href="mailto:contact@innovaitionedge.com">
        Talk to us
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 96px 0 64px;
  }
  .hero-inner {
    max-width: 880px;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-primary-700);
    margin-bottom: 1rem;
  }
  .hero-accent {
    color: var(--color-primary-700);
  }
  .lede {
    font-size: 1.15rem;
    color: var(--color-muted);
    max-width: 62ch;
    margin-bottom: 2rem;
  }
</style>
