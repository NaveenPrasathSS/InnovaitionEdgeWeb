---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';
import JsonLd from '../../components/JsonLd.astro';
import Button from '../../components/Button.astro';
import { services } from '../../data/services';
import { serviceSchema, breadcrumbSchema } from '../../lib/schema';

export const getStaticPaths = () =>
  services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));

const { service } = Astro.props;
const path = `/services/${service.slug}`;

const jsonLdService = serviceSchema({
  name: service.name,
  description: service.metaDescription,
  slug: path,
  serviceType: service.name,
});

const jsonLdBreadcrumb = breadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: service.name, path },
]);

const otherServices = services.filter((s) => s.slug !== service.slug);
---

<Layout
  title={`${service.name} — InnovAItion Edge`}
  description={service.metaDescription}
  canonical={path}
>
  <Fragment slot="head">
    <JsonLd schema={jsonLdService} />
    <JsonLd schema={jsonLdBreadcrumb} />
  </Fragment>

  <!-- Breadcrumb -->
  <nav class="breadcrumb container" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/services">Services</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{service.name}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="service-hero">
    <div class="container-narrow">
      <p class="eyebrow">{service.eyebrow}</p>
      <h1>{service.heroTitle}</h1>
      <p class="lede">{service.heroIntro}</p>
    </div>
  </section>

  <!-- Problem framing -->
  <section class="section problem-section" aria-labelledby="problem-h">
    <div class="container-narrow">
      <h2 id="problem-h">{service.problemHeading}</h2>
      {service.problemBody.map((p) => <p class="problem-p">{p}</p>)}
    </div>
  </section>

  <!-- Ships -->
  <section class="section ships-section" aria-labelledby="ships-h">
    <div class="container">
      <div class="ships-head">
        <p class="section-eyebrow">What we ship</p>
        <h2 id="ships-h">Deliverables, not slideware</h2>
      </div>
      <div class="ships-grid">
        {service.ships.map((s) => (
          <div class="ship">
            <h3>{s.heading}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Engagement -->
  <section class="section engagement-section" aria-labelledby="engagement-h">
    <div class="container-narrow">
      <p class="section-eyebrow">Engagement shape</p>
      <h2 id="engagement-h">{service.engagementHeading}</h2>
      <p class="engagement-body">{service.engagementBody}</p>
      <ul class="engagement-list">
        {service.engagementBullets.map((b) => <li>{b}</li>)}
      </ul>
      <div class="engagement-cta">
        <Button href="/contact" variant="primary" size="lg">Book a discovery call</Button>
      </div>
    </div>
  </section>

  <!-- Other services -->
  <section class="section other-section" aria-labelledby="other-h">
    <div class="container">
      <h2 id="other-h">Explore the other three practice areas</h2>
      <div class="other-grid">
        {otherServices.map((s) => (
          <a href={`/services/${s.slug}`} class="other-card">
            <p class="other-eyebrow">{s.eyebrow}</p>
            <p class="other-title">{s.cardTitle}</p>
            <span class="other-cta" aria-hidden="true">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>

<style>
  /* Breadcrumb */
  .breadcrumb {
    padding: var(--space-6) var(--space-6) 0;
  }
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--fs-sm);
    color: var(--color-ink-500);
  }
  .breadcrumb a {
    color: var(--color-ink-500);
  }
  .breadcrumb a:hover {
    color: var(--color-primary-700);
  }
  .breadcrumb [aria-current='page'] {
    color: var(--color-ink-900);
    font-weight: 500;
  }

  /* Hero */
  .service-hero {
    padding: var(--space-10) 0 var(--space-12);
    background: linear-gradient(180deg, #fff, var(--color-surface-alt));
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-4);
  }
  .service-hero h1 {
    max-width: 20ch;
  }
  .lede {
    font-size: var(--fs-lg);
    color: var(--color-ink-500);
    max-width: 60ch;
    margin: var(--space-6) 0 0;
    line-height: 1.6;
  }

  /* Sections */
  .section-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-3);
  }

  /* Problem */
  .problem-section h2 {
    max-width: 22ch;
    margin-bottom: var(--space-6);
  }
  .problem-p {
    font-size: var(--fs-md);
    color: var(--color-ink-500);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .problem-p:last-child {
    margin-bottom: 0;
  }

  /* Ships */
  .ships-section {
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }
  .ships-head {
    max-width: 720px;
    margin-bottom: var(--space-10);
  }
  .ships-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-8);
  }
  .ship {
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .ship h3 {
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-3);
  }
  .ship p {
    color: var(--color-ink-500);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0;
  }
  @media (max-width: 780px) {
    .ships-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Engagement */
  .engagement-section h2 {
    max-width: 22ch;
    margin-bottom: var(--space-4);
  }
  .engagement-body {
    color: var(--color-ink-500);
    font-size: var(--fs-md);
    line-height: 1.6;
    margin: 0 0 var(--space-6);
  }
  .engagement-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .engagement-list li {
    position: relative;
    padding-left: var(--space-6);
    color: var(--color-ink-700);
    font-size: var(--fs-md);
    line-height: 1.6;
  }
  .engagement-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 12px;
    height: 2px;
    background: var(--color-primary);
    border-radius: 2px;
  }
  .engagement-cta {
    padding-top: var(--space-4);
  }

  /* Other services */
  .other-section {
    padding-top: 0;
  }
  .other-section h2 {
    margin-bottom: var(--space-8);
    font-size: var(--fs-2xl);
  }
  .other-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .other-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: inherit;
    transition: border-color var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .other-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    text-decoration: none;
    color: inherit;
  }
  .other-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-primary-700);
    margin: 0 0 var(--space-2);
  }
  .other-title {
    color: var(--color-ink-900);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    margin: 0 0 var(--space-4);
    line-height: 1.3;
    flex-grow: 1;
  }
  .other-cta {
    color: var(--color-primary-700);
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  @media (max-width: 780px) {
    .other-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
